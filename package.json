{
  "schema_version": 1,
  "name": "tensor-lab-alan-vo",
  "version": "1.0.0",
  "description": "Kronos Tensor Lab - A Foundation Model for the Language of Financial Markets",
  "author": "Alan Vo <alanvo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALANDVO/tensor-lab-alan-vo.git"
  },
  "scripts": {
    "backend:dev": "cd backend && PYTHONPATH=. uvicorn app.main:app --reload --port 8000",
    "frontend:dev": "cd frontend && npm run dev",
